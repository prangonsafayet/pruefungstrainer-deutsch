# Copy this file to .env and fill in your own Supabase project values.
# Leave both empty (or delete .env) to run the trainer in local-only mode with browser storage
# only — no accounts, no sign-up, no requests to Supabase. The public deployment runs this way.
#
# Find these in Supabase → Project Settings → Data API:
#   VITE_SUPABASE_URL      the Project URL, exactly https://<project-ref>.supabase.co
#   VITE_SUPABASE_ANON_KEY the anon / publishable key (safe to ship to the browser; RLS protects the data)

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Absolute public URL of the deployed site. Used for canonical / Open Graph tags and the
# generated sitemap.xml + robots.txt. Netlify's own URL / DEPLOY_PRIME_URL is used if unset.
VITE_SITE_URL=

# Search engines. Unset = every page ships <meta name="robots" content="noindex, nofollow"> and no
# sitemap.xml. Set to true to allow indexing.
VITE_ALLOW_INDEXING=

# OAuth providers to offer on the sign-in card. Only list ones you actually enabled in
# Supabase → Authentication → Providers. Supported here: google, github, azure, apple.
VITE_AUTH_PROVIDERS=google,github

# Optional. Turns on dynamic feedback (LanguageTool-backed writing feedback and generated
# practice items). The client calls the public API at https://api.languagetool.org by
# default, which allows direct browser calls (no proxy, no hosting, no key) but caps
# requests at 20/minute per learner. Leave this unset to keep the feature off; leave it
# unset even if VITE_LANGUAGETOOL_URL is set below.
VITE_DYNAMIC_FEEDBACK=

# Optional. Overrides the public API above so the client calls a self-hosted LanguageTool
# instance instead — local Docker (http://localhost:8010) or a hosted one with richer
# n-gram data. Must be HTTPS (or localhost) in any build that is actually deployed. See
# docker/languagetool/README.md.
VITE_LANGUAGETOOL_URL=
