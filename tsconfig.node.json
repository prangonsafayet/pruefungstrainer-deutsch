{
  "//": "Build tooling that runs in Node: Vite, Playwright and ESLint config.",
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    /* vitest.config.ts imports the alias map from vite.config.ts by its real filename,
       the way the app source does. Safe here: nothing in this project is emitted. */
    "allowImportingTsExtensions": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,

    /* eslint.config.js is JS, so it needs allowJs to belong to a project at all —
       without it the editor treats the file as orphaned. It is not type-checked. */
    "allowJs": true,
    "checkJs": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "playwright.csp.config.ts",
    "eslint.config.js",
    "scripts/siteMeta.mjs",
    "scripts/trainerRegistry.mjs"
  ]
}
